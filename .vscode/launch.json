{
  // Run and Debug (F5): opens the app in Edge with VS Code's debugger attached (console output shows in the
  // Debug Console). Start the companion first: Terminal > Run Task > "Neural Studio: start".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Neural Studio (companion)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8000/#machine",
      "webRoot": "${workspaceFolder}/web"
    },
    {
      "name": "Neural Studio (web app only)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5180/?browser#machine",
      "webRoot": "${workspaceFolder}/web"
    }
  ]
}
