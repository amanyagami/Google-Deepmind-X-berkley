{
  // Terminal > Run Task... (or Ctrl+Shift+B for the default one)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Neural Studio: start",
      "detail": "Companion + app on http://127.0.0.1:8000 (measured power, live runs)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/start.ps1",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Neural Studio: build web app",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Neural Studio: web app only (no companion)",
      "detail": "Static server on http://127.0.0.1:5180/?browser",
      "type": "shell",
      "command": "python -m http.server 5180 --bind 127.0.0.1 --directory web/dist",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Neural Studio: unit tests",
      "type": "shell",
      "command": "cd web; npm test; cd ../server; ./.venv/Scripts/python.exe -m pytest -q",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Neural Studio: live 3D browser test",
      "detail": "Needs 'start' running. Runs the full measurement in headless Edge; screenshots in examples/screens/live",
      "type": "shell",
      "command": "node tests/e2e/live.mjs ../examples/screens/live http://127.0.0.1:8000/#machine",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
