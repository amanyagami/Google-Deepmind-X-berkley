# Server configuration (optional - defaults to in-memory leaderboard on port 3000)
PORT=3000
HOST=0.0.0.0
KUNDALI_STORE=memory
KUNDALI_DIST=
KUNDALI_TRUST_PROXY=
KUNDALI_PROXY_HOPS=1
KUNDALI_ORIGINS=
KUNDALI_RATE_DEVICE=10
KUNDALI_RATE_IP=30
KUNDALI_RATE_READS=120

# Optional Google Cloud Firestore persistence for leaderboard
GOOGLE_CLOUD_PROJECT=
KUNDALI_FIRESTORE_DB=
KUNDALI_COLLECTION=scores
