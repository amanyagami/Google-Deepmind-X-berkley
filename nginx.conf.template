# Rendered to /etc/nginx/conf.d/default.conf at start; ${PORT} comes from the environment.
# Headers mirror web/public/_headers (keep both in step).

map $uri $ns_cache {
    default            "";
    ~^/assets/         "public, max-age=31536000, immutable";
    ~^/ort/            "public, max-age=31536000, immutable";
    /sw.js             "no-cache";
    /                  "no-cache";
    /index.html        "no-cache";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    absolute_redirect off;

    # stock types (wasm, json, js...) plus the two nginx does not know
    include /etc/nginx/mime.types;
    types {
        text/javascript             mjs;
        application/octet-stream    onnx;
    }

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/wasm application/octet-stream image/svg+xml;

    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "credentialless" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://huggingface.co https://*.hf.co; media-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob: https://huggingface.co https://*.huggingface.co https://*.hf.co http://127.0.0.1:8000 ws://127.0.0.1:8000; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control $ns_cache;

    # hashed build files and the ONNX runtime: a missing file is a real 404, never index.html
    location /assets/ { try_files $uri =404; }
    location /ort/    { try_files $uri =404; }

    # single-page app: unknown paths get index.html
    location / { try_files $uri $uri/ /index.html; }
}
